# Port Server Backend
PORT=5000

# PostgreSQL Connection String (Supabase / Neon / Local PostgreSQL)
# Example Supabase Transaction Pooler (Session mode or Direct mode):
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/honeycake_db?schema=public"

# JWT Secret for Staff/Admin authentication
JWT_SECRET="honeycake-super-secret-jwt-key-2026"
JWT_EXPIRES_IN="1d"

# Frontend URL for CORS and Table QR Code link generation
FRONTEND_URL="http://localhost:5173"
